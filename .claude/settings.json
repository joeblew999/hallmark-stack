{
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Write|Edit|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/skills/hallmark/scripts/lint-hook.mjs\"",
						"timeout": 10
					}
				]
			}
		],
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/mise-check-session-start.sh"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "[ \"${CLAUDE_CODE_REMOTE:-}\" = true ] && [ -n \"${CLAUDE_ENV_FILE:-}\" ] && echo \"eval \\\"\\$(mise activate bash --shims)\\\"\" >> \"$CLAUDE_ENV_FILE\" || true"
					}
				]
			}
		]
	}
}
