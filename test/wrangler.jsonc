// Worker used only by the test suite, to host VenueDO in workerd on its own.
{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "hallmark-stack-test",
	"main": "./worker.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"durable_objects": { "bindings": [{ "name": "VENUE", "class_name": "VenueDO" }] },
	"exports": { "VenueDO": { "type": "durable-object", "storage": "sqlite" } }
}
