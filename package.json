{
	"name": "hallmark-stack",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev --port 4710 --strictPort",
		"build": "vite build",
		"preview": "vite preview --port 4711 --strictPort",
		"deploy": "vite build && wrangler deploy",
		"typegen": "wrangler types && tsr generate",
		"typecheck": "wrangler types && tsr generate && tsc",
		"check": "biome check",
		"format": "biome check --write",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"hallmark": "node .claude/skills/hallmark/scripts/sloplint.mjs src/styles.css src/styles --url http://localhost:4710/ --render --genre editorial",
		"verify": "aube run check && aube run typecheck && aube run test && aube run build"
	},
	"dependencies": {
		"@fontsource/radio-canada": "5.3.0",
		"@fontsource/radio-canada-big": "5.3.0",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-start": "1.169.4",
		"better-auth": "1.7.16",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"drizzle-orm": "0.45.4",
		"lucide-react": "1.65.0",
		"radix-ui": "1.8.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"sonner": "2.0.8",
		"tailwind-merge": "3.7.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@cloudflare/vite-plugin": "1.66.0",
		"@cloudflare/vitest-plugin": "1.4.11",
		"@playwright/test": "1.64.1",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/router-cli": "1.167.46",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"drizzle-kit": "0.31.11",
		"puppeteer-core": "25.12.0",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "7.0.2",
		"vite": "8.3.5",
		"vitest": "5.0.5",
		"wrangler": "4.156.0"
	}
}
