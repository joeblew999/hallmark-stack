{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Cloudflare's environments (issue #9): the top level is development, for aube run dev, the tests and CI, and is
	// never deployed. staging and production are deployed with CLOUDFLARE_ENV, as Workers named courts-<env>.
	// Wrangler doesn't inherit bindings, vars or secrets into an environment, so each one names its own; aube run
	// config:check fails if one is missing.
	"name": "courts",
	"main": "src/server.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	// Request logs, and traces with a span for every D1 query and binding call (issue #5).
	"observability": { "enabled": true, "traces": { "enabled": true } },
	"upload_source_maps": true,
	// Once a day, bookings older than a month are deleted.
	"triggers": { "crons": ["17 3 * * *"] },
	// Who has signed in through Gateweave ID, and their sessions (Better Auth). Local only here.
	"d1_databases": [{ "binding": "DB", "database_name": "courts", "migrations_dir": "migrations" }],
	// One Durable Object per venue holds its bookings (src/server/venue-do.ts). RateLimiter counts sign-in requests
	// across every isolate (src/server/rate-limit/, from Track).
	"durable_objects": {
		"bindings": [
			{ "name": "VENUE", "class_name": "VenueDO" },
			{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }
		]
	},
	"exports": {
		"VenueDO": { "type": "durable-object", "storage": "sqlite" },
		"RateLimiter": { "type": "durable-object", "storage": "sqlite" }
	},
	// Where a venue's Durable Object starts (src/server/venue.ts), next to its people: the venues are in Thailand,
	// and D1 is made there too (issue #5).
	// BETTER_AUTH_URL empty: courts' address is taken from each request. mise run all:dev sets it in .dev.vars to its
	// Tailscale Funnel address (scripts/dev.mjs), as Gateweave ID's is set; Wrangler loads a .dev.vars value for a var.
	"vars": { "LOCATION": "apac", "BETTER_AUTH_URL": "" },
	"placement": { "region": "aws:ap-northeast-1" },
	// Every secret courts uses, so Wrangler loads each from .dev.vars (with `secrets` set it loads only these) and types
	// them. Development is never deployed, so none of them can block a deploy. `mise run all:dev` writes the OIDC three
	// (app:register, local). Staging and production name only BETTER_AUTH_SECRET: there the OIDC three arrive after the
	// first deploy (id:deploy, app:deploy, then app:register), and Wrangler refuses a new Worker missing a required one.
	"secrets": {
		"required": ["BETTER_AUTH_SECRET", "OIDC_ISSUER", "OIDC_CLIENT_ID", "OIDC_CLIENT_SECRET"]
	},
	"env": {
		"staging": {
			// A Workers Custom Domain: Gateweave ID reaches it there, never on workers.dev (issue #2).
			"routes": [{ "pattern": "courts-staging.ubuntusoftware.net", "custom_domain": true }],
			"triggers": { "crons": ["17 3 * * *"] },
			"d1_databases": [
				{ "binding": "DB", "database_name": "courts-staging", "migrations_dir": "migrations" }
			],
			"durable_objects": {
				"bindings": [
					{ "name": "VENUE", "class_name": "VenueDO" },
					{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }
				]
			},
			"vars": { "LOCATION": "apac" },
			"placement": { "region": "aws:ap-northeast-1" },
			"secrets": { "required": ["BETTER_AUTH_SECRET"] }
		},
		"production": {
			"routes": [{ "pattern": "courts.ubuntusoftware.net", "custom_domain": true }],
			"triggers": { "crons": ["17 3 * * *"] },
			"d1_databases": [
				{ "binding": "DB", "database_name": "courts-production", "migrations_dir": "migrations" }
			],
			"durable_objects": {
				"bindings": [
					{ "name": "VENUE", "class_name": "VenueDO" },
					{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }
				]
			},
			"vars": { "LOCATION": "apac" },
			"placement": { "region": "aws:ap-northeast-1" },
			"secrets": { "required": ["BETTER_AUTH_SECRET"] }
		}
	}
}
